# FastAPI backend
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# Docker Compose. Defaults below are only for local development.
TZB_BACKEND_PORT=8000
TZB_DB_NAME=tzb_yingshi
TZB_DB_USER=app
TZB_DB_PASSWORD=change-me
APP_SEED_DEMO=true
# Set to true before building the image if SenseVoice is needed.
INSTALL_SENSEVOICE=false

# PostgreSQL. Never commit a real password.
APP_DATABASE_ENABLED=false
APP_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/tzb_yingshi
APP_DATABASE_ECHO=false
APP_DEMO_IDENTITY_ENABLED=false
APP_DEMO_ELDER_SUBJECT=u-elder-001
APP_DEMO_GUARDIAN_SUBJECT=u-family-001

# EZVIZ signal ingestion. Replace the token before enabling outside local development.
APP_YS7_SIGNAL_ENABLED=false
APP_YS7_WEBHOOK_TOKEN=
APP_YS7_QUEUE_MAXSIZE=1000
APP_YS7_RAW_EVENT_DIR=backend/storage/ys7/raw

# EZVIZ live media ingestion. Keep secrets only in the local .env or secret manager.
APP_YS7_MEDIA_ENABLED=false
APP_YS7_APP_KEY=
APP_YS7_APP_SECRET=
# Optional: use a pre-issued access token instead of AppKey/AppSecret refresh.
APP_YS7_ACCESS_TOKEN=
APP_YS7_DEVICE_SERIAL=
APP_YS7_CHANNEL_NO=1
APP_YS7_LIVE_PROTOCOL=flv
APP_YS7_LIVE_QUALITY=2
APP_YS7_MEDIA_QUEUE_MAXSIZE=32
APP_YS7_VAD_MODE=2
APP_YS7_ELDER_ALONE=false

# SenseVoice short WAV chunks. Install with: uv sync --extra sensevoice
APP_SENSEVOICE_ENABLED=false
APP_SENSEVOICE_MODEL=iic/SenseVoiceSmall
APP_SENSEVOICE_DEVICE=cpu
APP_SENSEVOICE_MAX_CHUNK_BYTES=10485760
APP_STREAMING_ASR_ENABLED=false
APP_STREAMING_ASR_MODEL=paraformer-zh-streaming
APP_STREAMING_ASR_DEVICE=cpu
APP_STREAMING_ASR_HOTWORDS=验证码 安全账户 屏幕共享 远程控制 涉案资金 转账 汇款 取现
APP_STREAMING_ASR_HOTWORD_CORRECTIONS={}

# Optional text and YS7 snapshot LLM review. Uses OpenAI-compatible chat completions.
APP_FRAUD_LLM_ENABLED=false
APP_FRAUD_LLM_BASE_URL=
APP_FRAUD_LLM_API_KEY=
APP_FRAUD_LLM_MODEL=
APP_FRAUD_LLM_TIMEOUT_SECONDS=10
APP_FRAUD_LLM_ENABLE_THINKING=false
APP_FRAUD_LLM_QUEUE_MAXSIZE=32
APP_FRAUD_LLM_TRIGGER_STATE_INDEX=2
APP_FRAUD_LLM_MAX_TRANSCRIPT_CHARS=6000
APP_FRAUD_LLM_VISION_ENABLED=false
APP_FRAUD_LLM_MAX_IMAGES=4
