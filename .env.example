# FastAPI backend
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# Docker Compose. Defaults below are only for local development.
TZB_BACKEND_PORT=8000
TZB_DB_NAME=tzb_yingshi
TZB_DB_USER=app
TZB_DB_PASSWORD=change-me
APP_SEED_DEMO=true
# Set to true before building the image if SenseVoice is needed.
INSTALL_SENSEVOICE=false

# PostgreSQL. Never commit a real password.
APP_DATABASE_ENABLED=false
APP_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/tzb_yingshi
APP_DATABASE_ECHO=false
APP_DEMO_ELDER_SUBJECT=u-elder-001
APP_DEMO_GUARDIAN_SUBJECT=u-family-001
APP_DEMO_ELDER_NAME=演示老人
APP_DEMO_GUARDIAN_NAME=演示家属
APP_DEMO_ELDER_LOGIN=elder
APP_DEMO_GUARDIAN_LOGIN=guardian
APP_DEMO_ELDER_PASSWORD=elder123
APP_DEMO_GUARDIAN_PASSWORD=guardian123
APP_AUTH_SESSION_TTL_HOURS=168

# EZVIZ signal ingestion. Replace the token before enabling outside local development.
APP_YS7_SIGNAL_ENABLED=false
APP_YS7_WEBHOOK_TOKEN=
APP_YS7_QUEUE_MAXSIZE=1000
APP_YS7_RAW_EVENT_DIR=backend/storage/ys7/raw
# Competition/demo polling. Use 10 seconds for 24/7 personal-plan operation.
APP_YS7_ALARM_POLL_ENABLED=false
APP_YS7_ALARM_POLL_INTERVAL_SECONDS=5
APP_YS7_ALARM_POLL_LOOKBACK_SECONDS=120
APP_YS7_ALARM_POLL_PAGE_SIZE=50

# EZVIZ live media ingestion. Keep secrets only in the local .env or secret manager.
APP_YS7_MEDIA_ENABLED=false
# C6c standard FLV/HLS/RTMP may omit audio. Use app_relay to send EZOpenSDK PCM.
APP_YS7_MEDIA_SOURCE=app_relay
APP_YS7_APP_KEY=
APP_YS7_APP_SECRET=
# Optional: use a pre-issued access token instead of AppKey/AppSecret refresh.
APP_YS7_ACCESS_TOKEN=
APP_YS7_DEVICE_SERIAL=
APP_YS7_CHANNEL_NO=1
APP_YS7_LIVE_PROTOCOL=flv
APP_YS7_LIVE_QUALITY=2
APP_YS7_MEDIA_QUEUE_MAXSIZE=32
APP_YS7_PCM_RELAY_QUEUE_MAXSIZE=8
APP_YS7_VAD_MODE=2
APP_YS7_ELDER_ALONE=false

# SenseVoice short WAV chunks. Install with: uv sync --extra sensevoice
APP_SENSEVOICE_ENABLED=false
APP_SENSEVOICE_MODEL=iic/SenseVoiceSmall
APP_SENSEVOICE_DEVICE=cpu
APP_SENSEVOICE_MAX_CHUNK_BYTES=10485760
APP_STREAMING_ASR_ENABLED=false
APP_STREAMING_ASR_MODEL=paraformer-zh-streaming
APP_STREAMING_ASR_DEVICE=cpu
APP_STREAMING_ASR_HOTWORDS=验证码 安全账户 屏幕共享 远程控制 涉案资金 转账 汇款 取现
APP_STREAMING_ASR_HOTWORD_CORRECTIONS={}

# Optional text and YS7 snapshot LLM review. Uses OpenAI-compatible chat completions.
APP_FRAUD_LLM_ENABLED=false
APP_FRAUD_LLM_BASE_URL=
APP_FRAUD_LLM_API_KEY=
APP_FRAUD_LLM_MODEL=
APP_FRAUD_LLM_TIMEOUT_SECONDS=10
APP_FRAUD_LLM_ENABLE_THINKING=false
APP_FRAUD_LLM_QUEUE_MAXSIZE=32
APP_FRAUD_LLM_TRIGGER_STATE_INDEX=2
APP_FRAUD_LLM_MAX_TRANSCRIPT_CHARS=6000
APP_FRAUD_LLM_VISION_ENABLED=false
APP_FRAUD_LLM_MAX_IMAGES=4
# 延迟埋点开关（阶段计时与回放基线），关闭时不改变业务结果
APP_FRAUD_LATENCY_TRACE_ENABLED=false
# 模型预热：启动时提前加载分类器与 ASR 模型，失败不阻止健康检查和业务启动
APP_FRAUD_CLASSIFIER_WARMUP_ENABLED=true
APP_SENSEVOICE_WARMUP_ENABLED=true
APP_STREAMING_ASR_WARMUP_ENABLED=true
# VAD 参数化（必须为 20ms 整数倍；回放对比无收益不改默认值）
APP_YS7_VAD_SPEECH_START_MS=200
APP_YS7_VAD_SILENCE_END_MS=700
APP_STREAMING_CHUNK_MS=600
# 阶段 6 中长期能力：语义检索与近期风险画像，默认关闭（评测触发后才开启）
APP_FRAUD_SEMANTIC_RETRIEVER_ENABLED=false
APP_FRAUD_RECENT_RISK_ENABLED=false
# PARTIAL 两级预警（PRELIMINARY 需连续命中强动作证据，FINAL 确认/撤回）
APP_FRAUD_PRELIMINARY_ALERT_ENABLED=false
APP_FRAUD_PRELIMINARY_MIN_CONFIDENCE=0.90
APP_FRAUD_PRELIMINARY_STABLE_REVISIONS=2
APP_FRAUD_PRELIMINARY_CONFIRM_MIN_STATE_INDEX=2

# Fall-risk algorithm service. Fixed Fusion is not an App decision source.
APP_FALL_RISK_ENABLED=false
# Existing multimodal prototype (living-room Camera-led C output).
APP_FALL_RISK_BASE_URL=http://host.docker.internal:8001
# One Radar FastAPI process/base URL per room; JSON is parsed by pydantic-settings.
APP_FALL_RISK_RADAR_ROOM_URLS={"bathroom":"http://host.docker.internal:8010","bedroom":"http://host.docker.internal:8011"}
APP_FALL_RISK_API_KEY=
APP_FALL_RISK_TIMEOUT_SECONDS=2.0
APP_FALL_RISK_CAMERA_LED_PATH=/api/multimodal/camera-led-associated/latest
APP_FALL_RISK_RADAR_ONLY_PATH=/api/radar/latest

# Psychology reference-observation projection. Phase 1 is read-only shadow mode.
APP_PSYCHOLOGY_ENABLED=false
APP_PSYCHOLOGY_BASE_URL=http://host.docker.internal:8020
APP_PSYCHOLOGY_API_KEY=
APP_PSYCHOLOGY_TIMEOUT_SECONDS=2.0
APP_PSYCHOLOGY_LATEST_PATH=/api/psychology/assessments/latest

# ============ Radar Windows 宿主 launcher（start-dev.ps1 / stop-dev.ps1）============
# 有 torch 的宿主 Python（如 E:\python3.10.9aaa\python.exe）；留空则用 PATH 中的 python
RADAR_PYTHON=
# 每个房间模式：disabled / replay / real（real 需 worker 支持 TI 桥接，当前仅 replay）
RADAR_BATHROOM_MODE=disabled
RADAR_BEDROOM_MODE=disabled
# replay 数据文件（相对仓库根或绝对路径）
RADAR_BATHROOM_REPLAY_FILE=
RADAR_BEDROOM_REPLAY_FILE=
# 校准 TCN checkpoint 与校准文件（相对仓库根或绝对路径）
RADAR_WORKER_CHECKPOINT=backend/app/modules/fall/radar_module/checkpoints/experiments_v5/tcn_hard_negative/tcn_0p5_1p0_specificity_operating_point_v1.pt
RADAR_WORKER_CALIBRATION=backend/app/modules/fall/radar_module/reports/domain_calibration_v1_full/calibrated_normalization_real_gaussian.json
# worker 运行期状态目录（相对仓库根或绝对路径）
RADAR_RUNTIME_STATE_DIR=backend/app/modules/fall/radar_module/runtime_state
# 校准 TCN checkpoint 的 SHA256 校验（对应上方默认 checkpoint；校准 TCN 复用该 TCN 权重）
RADAR_WORKER_CHECKPOINT_SHA256=0792a712b57ae89875b2d57e6ba7a20763618a2718e961cf8c48acebe34970ef
