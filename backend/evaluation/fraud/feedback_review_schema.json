{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "fraud-feedback-review-record",
  "description": "Schema for one desensitized FALSE_ALARM review record produced by backend/app/scripts/export_fraud_feedback.py. Reviewers confirm per-evidence labels; the record is only merged into the versioned train.jsonl after human approval. No direct identifiers, audio URLs or sensitive entities may appear.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_digest",
    "occurred_at",
    "risk_level",
    "alert_level",
    "summary",
    "state",
    "state_index",
    "evidence",
    "reviewed",
    "review_notes"
  ],
  "properties": {
    "event_digest": {
      "type": "string",
      "minLength": 16,
      "maxLength": 16,
      "description": "Irreversible SHA-256 digest of the database event id."
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "risk_level": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", null] },
    "alert_level": { "enum": ["REMINDER", "WARNING", "EMERGENCY", null] },
    "summary": { "type": "string", "description": "Masked event summary." },
    "state": { "type": "string" },
    "state_index": { "type": ["integer", "null"], "minimum": 0, "maximum": 5 },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "stage", "strength", "text", "reason", "used_for_transition"],
        "properties": {
          "kind": { "type": "string" },
          "stage": { "type": "string" },
          "strength": { "type": "string" },
          "text": { "type": "string", "description": "Masked transcript." },
          "reason": { "type": "string", "description": "Masked evidence reason." },
          "used_for_transition": { "type": "boolean" },
          "decayed_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    },
    "reviewed": {
      "type": "boolean",
      "description": "True only after a human confirms every evidence label. FALSE_ALARM does not automatically make every label negative."
    },
    "review_notes": { "type": "string" }
  }
}
