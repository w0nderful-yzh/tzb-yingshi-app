# Radar FastAPI
RADAR_REPLAY_ROOT=./data/replay
RADAR_CHECKPOINT_PATH=./checkpoints/radar_lstm_test.pt
RADAR_DEVICE_ID=iwr6843isk-01
RADAR_ROOM=bathroom
RADAR_MAX_DISTANCE_M=8
RADAR_RISK_THRESHOLD=0.7
RADAR_CONSECUTIVE_WINDOWS=3
RADAR_TORCH_DEVICE=cpu

# v2研究预测头只作为影子输出显示在前端，不触发正式告警。
RADAR_RESEARCH_SHADOW_ENABLED=false
RADAR_RESEARCH_CHECKPOINT_PATH=./checkpoints/radar_lstm_research_dguha_prefall_dense_pw32_v2.pt
RADAR_RESEARCH_CONFIRMATION_WINDOWS=3

# 最终因果TCN仅以影子模式运行；不得与旧研究影子同时启用。
RADAR_TCN_SHADOW_ENABLED=true
RADAR_TCN_CHECKPOINT_PATH=./checkpoints/experiments_v5/tcn_hard_negative/tcn_0p5_1p0_specificity_operating_point_v1.pt
RADAR_TCN_CHECKPOINT_SHA256=0792a712b57ae89875b2d57e6ba7a20763618a2718e961cf8c48acebe34970ef
RADAR_TCN_CONFIRMATION_WINDOWS=3
RADAR_POINTNET_SHADOW_ENABLED=false
RADAR_POINTNET_CHECKPOINT_PATH=./checkpoints/experiments_v9/pointnet_formal_conservative/pointnet_gru_radar_branch_v1.pt
RADAR_POINTNET_CHECKPOINT_SHA256=2139d94627ade76728cc179a13f471d00f84aa4ed13ab273d3561f3b13b16042
RADAR_POINTNET_CONFIRMATION_WINDOWS=3

# REAL模式：桥接进程调用 Radar Toolbox 官方 UARTParser，
# 自动将 ISK_6m_default.cfg 发到 COM5，并把 COM6 解码帧转为JSONL。
# 真雷达实时模式需要配置本机路径；每个人的安装位置可以不同。
# 请把真实路径写入本地 .env（不进入 Git）；JSON 中的反斜杠需双写。
# 示例：
#   TI_OFFICIAL_OUTPUT_COMMAND_JSON=["<TI Python 路径>","-m","radar_module.acquisition.ti_official_bridge","--cli-port","COM5","--data-port","COM6"]
#   TI_OFFICIAL_OUTPUT_CWD=<radar_module 目录>
TI_OFFICIAL_OUTPUT_COMMAND_JSON=
TI_OFFICIAL_OUTPUT_CWD=
