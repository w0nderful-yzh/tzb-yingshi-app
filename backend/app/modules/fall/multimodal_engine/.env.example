APP_NAME=Elder Risk Prototype
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001
DEBUG=false
DEMO_MODE=true

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=elder_risk_prototype
MYSQL_USERNAME=elder_risk_app
MYSQL_PASSWORD=

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800

FRONTEND_ORIGIN=http://127.0.0.1:8088

EZVIZ_BASE_URL=https://open.ys7.com/api/lapp
EZVIZ_APP_KEY=
EZVIZ_APP_SECRET=
EZVIZ_DEVICE_VERIFY_CODE=
EZVIZ_REQUEST_TIMEOUT_SECONDS=10
EZVIZ_TOKEN_REFRESH_SKEW_SECONDS=60

# IWR6843ISK Radar FastAPI（默认单独运行在8010端口）
RADAR_INTEGRATION_ENABLED=true
RADAR_SERVICE_URL=http://127.0.0.1:8010
RADAR_POLL_INTERVAL_SECONDS=0.05
RADAR_REQUEST_TIMEOUT_SECONDS=2
# P2真实训练和验证完成前必须保持false。
RADAR_FORMAL_PREDICTIONS_ENABLED=false

# Camera-led多模态判断：Camera主判断，Radar仅提供关联后的运动学证据。
FUSION_SYNC_TOLERANCE_SECONDS=2.0
FUSION_V2_MINIMUM_CAMERA_QUALITY=0.25
FUSION_SHADOW_LOG_ENABLED=true
FUSION_SHADOW_LOG_MAX_MB=20
FUSION_SHADOW_LOG_BACKUP_COUNT=5
# 默认使用本模块calibrations/living_room_grid9_shadow_v0.json。
# FUSION_ALIGNMENT_CALIBRATION_PATH=<calibration-json-path>
# BioSTGCN真实视频推理。默认值会从当前workspace自动推导；发布到其他机器时覆盖。
# FALL_INFERENCE_PROJECT_DIR=<biostgcn-project-directory>
# FALL_INFERENCE_PYTHON=<python-executable-path>
FALL_INFERENCE_TIMEOUT_SECONDS=900
FALL_INFERENCE_MAX_UPLOAD_MB=250
FALL_INFERENCE_DEVICE=cuda:0

# 萤石实时云流按需取片。3=RTMP（默认），2=HLS，4=HTTP-FLV；质量1=高清，2=流畅。
# 标准流通常要求设备在线、视频编码为H.264，并可能要求关闭设备视频加密。
FALL_INFERENCE_LIVE_PROTOCOL=2
FALL_INFERENCE_LIVE_QUALITY=2
FALL_INFERENCE_LIVE_CAPTURE_SECONDS=10
FALL_INFERENCE_LIVE_ADDRESS_EXPIRE_SECONDS=120
FALL_INFERENCE_LIVE_CAPTURE_TIMEOUT_SECONDS=60

# 本机比赛环境使用完整CUDA虚拟环境持续运行RTMPose3D/BioSTGCN。
FALL_LIVE_MONITOR_ENABLED=true
FALL_LIVE_SOURCE_MODE=ezviz_opensdk
# EZUIKit截图桥接的保守可持续速率；它不是30 FPS原始帧接口。
FALL_LIVE_BROWSER_CAPTURE_FPS=2
FALL_LIVE_BROWSER_MAX_FRAME_KB=768
FALL_LIVE_MIN_KEYPOINT_CONFIDENCE=0.10
FALL_LIVE_MIN_VALID_POSE_RATIO=0.70
# 冻结模型只在真实收齐90个源帧且无时间缺口时运行。
FALL_LIVE_REQUIRED_SOURCE_FRAMES=90
FALL_LIVE_MAX_SOURCE_GAP_FRAMES=1
FALL_LIVE_DEVICE_ID=
FALL_LIVE_CHANNEL_NO=1
FALL_LIVE_STRIDE_FRAMES=15
FALL_LIVE_MAX_QUEUE_FRAMES=2
FALL_LIVE_STREAM_STALL_TIMEOUT_SECONDS=6
FALL_LIVE_RECONNECT_SECONDS=2
# OpenSDK-only rPPG sidecar. Shadow/display only; no risk-score modulation.
RPPG_ENABLED=false
RPPG_SQI_THRESHOLD=0.7
RPPG_MIN_VALID_SECONDS=60
FALL_LIVE_EVENT_COOLDOWN_SECONDS=30
FALL_LIVE_AUTO_CREATE_SESSION=true
